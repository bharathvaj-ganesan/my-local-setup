# ~/.zshrc.local  (private: never commit)
# Machine- or employer-specific settings: SDK paths, extra PATH entries,
# project env vars and aliases. Sourced by ~/.zshrc.

# --- SDKs ---
# export JAVA_HOME=/Library/Java/JavaVirtualMachines/<your-jdk>/Contents/Home
# export PATH="$JAVA_HOME/bin:$PATH"

# --- Extra PATH entries ---
# export PATH="$HOME/.nvm/versions/node/<version>/bin:$PATH"

# --- Project env vars (non-secret) ---
# export MY_TEAM_NAME=<team>

# --- Project aliases ---
# alias deploy="./scripts/deploy.sh"

# --- Company tooling ---
# [ -f "$HOME/.some-tool/init.sh" ] && source "$HOME/.some-tool/init.sh"
