# ~/.secrets  (private: never commit; install.sh creates it with chmod 600)
# Copy of secrets.example with placeholders. Fill in real values locally.
# Sourced by ~/.zshrc on every shell start.

export NPM_TOKEN="<your-npm-token>"
export GH_USERNAME="<your-github-username>"
# export AWS_PROFILE="default"
# export OPENAI_API_KEY="<...>"
